# ============================================================
# 面试复盘助手 — 环境变量模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不要提交。
# ============================================================

# ---------- DeepSeek（复盘报告生成）----------
# 官方控制台：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型名为 deepseek-flash（对应 DeepSeek-V4.1-Flash）
DEEPSEEK_MODEL=deepseek-flash

# ---------- 阿里云百炼（语音转写）----------
# 控制台：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 注意：必须用 paraformer-v2。
# 不要用 qwen3-asr-flash-filetrans —— 它名字最像最新款，但不支持说话人分离。
BAILIAN_ASR_MODEL=paraformer-v2
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com

# ---------- 阿里云 OSS（音频托管）----------
# 百炼的文件转写只接受公网 URL，所以音频必须先传 OSS 再生成签名 URL。
# 建议使用 RAM 子账号，只授予该 bucket 的读写权限，不要用主账号 AK。
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 签名 URL 有效期（秒）。转写任务可能排队，默认 24 小时。
OSS_SIGNED_URL_TTL_SECONDS=86400

# ---------- 本地运行 ----------
# 留空则自动使用 imageio-ffmpeg 自带的 ffmpeg 二进制
FFMPEG_PATH=
FFPROBE_PATH=
# 数据目录（SQLite、临时音频），已在 .gitignore 中
DATA_DIR=backend/data

# ---------- 访问口令（部署上线必须设置） ----------
# 留空 = 不启用鉴权，仅限本机使用。
# 部署到公网必须设置：前端首次打开会弹出输入框，填这里同一个值即可。
# 所有人共用这一个口令（个人工具足够；要多人独立账号再说）。
APP_ACCESS_CODE=
